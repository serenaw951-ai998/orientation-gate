{
  "name": "orienta_core",
  "description": "Orienta v0.3 canonical core result. Replaces historical output schema; evaluator scores are heuristic.",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "PROCEED",
        "MODIFY",
        "ESCALATE",
        "BLOCK"
      ]
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasoning": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "type": "string"
    },
    "safer_objective": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggered_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluator_version": {
      "type": "string",
      "enum": [
        "orienta_engine_v0.3"
      ]
    },
    "orientation_evidence": {
      "type": "object"
    }
  },
  "required": [
    "decision",
    "risk_score",
    "confidence",
    "reason_codes",
    "reasoning",
    "recommended_action",
    "safer_objective",
    "evaluator_version"
  ]
}
